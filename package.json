{
  "name": "autonex-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "dev:api": "uv run --project backend uvicorn autonex.api.app:create_app --app-dir backend/src --factory --reload --host 127.0.0.1 --port 8000",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend/src tests vite.config.ts playwright.config.ts",
    "format": "prettier --write frontend tests *.md *.json *.ts *.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:backend": "uv run --project backend pytest -c backend/pyproject.toml backend/tests",
    "check:backend": "uv run --project backend ruff check backend && uv run --project backend ruff format --check backend && uv run --project backend mypy --config-file backend/pyproject.toml backend/src",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.py": [
      "uv run --project backend ruff check --fix",
      "uv run --project backend ruff format"
    ],
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
