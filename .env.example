# Safe offline mode: no LLM requests, local mock MCP tools.
AGENT_MODE=demo
# Server only. Never expose these through a VITE_ variable.
# OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Optional OpenAI-compatible LangChain chat/embedding endpoint.
# LLM_BASE_URL=https://your-authorized-provider.example/v1
# Local development defaults to backend/var/autonex.sqlite3.
# PostgreSQL: run Alembic before starting the API.
# DATABASE_URL=postgresql+psycopg://autonex:password@localhost:5432/autonex
POSTGRES_PASSWORD=local-demo-only
VECTOR_DIMENSIONS=1536
AGENT_TIMEOUT_SECONDS=90
MAX_CONCURRENT_RUNS=4
TRACING_ENABLED=false
# Vite defaults to /api/v1 through its local proxy. Docker uses Nginx.
# VITE_API_BASE_URL=/api/v1

# Frontend: auto uses FastAPI when all startup resources respond, otherwise local demo.
# Set demo to skip all backend connection checks. Both modes show the complete UI.
VITE_WORKSPACE_MODE=auto
